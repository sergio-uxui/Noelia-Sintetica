# ============================================================
# Noelia Sintética — Variables de entorno
# Copia este fichero a .env y rellena tus valores reales.
# NUNCA subas .env a control de versiones.
# ============================================================

# --- Obligatorio ---

# Clave API de Anthropic (obtén la tuya en https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- Opcional: Notificaciones por email ---

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@email.com
# SMTP_PASS=tu_contraseña_de_aplicacion
# SMTP_TO=destino@email.com


# --- Opcional: Notificaciones por Telegram ---

# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_CHAT_ID=-100123456789


# --- Opcional: Nivel de log (DEBUG, INFO, WARNING, ERROR) ---

# LOG_LEVEL=INFO


# --- Opcional: Ruta de la base de datos ---
# En local: por defecto "data/noelia.db" (relativo al proyecto)
# En Railway: usar /data/noelia.db (volumen persistente)
# En Streamlit Cloud: usar /tmp/noelia.db (se borra al reiniciar)

# DB_PATH=/data/noelia.db
